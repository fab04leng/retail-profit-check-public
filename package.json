{
  "name": "retail-profit-check",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side profit, stock, supplier-invoice and cash-flow health check for Malaysian retail SMEs (demo / pilot tool).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:accuracy": "vitest run tests/accuracy",
    "test:perf": "vitest run tests/perf",
    "test:e2e": "playwright test",
    "demo:export": "tsx scripts/export-demo.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run build:offline && npm run test:e2e",
    "build:offline": "tsc -b && vite build --mode offline",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='src/ui/**' --coverage.exclude='src/main.tsx' --coverage.exclude='src/worker/analysis.worker.ts' --coverage.exclude='src/worker/client.ts' --coverage.exclude='src/i18n/zh.ts' --coverage.exclude='src/i18n/ms.ts'"
  },
  "dependencies": {
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
